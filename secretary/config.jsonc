{
  "name": "The Secretary",
  "description": "Flags files exceeding 10,000 lines of code",
  "patterns": ["*"],
  "scanAllText": true,
  "ignoreAll": false,

  "dbSchema": {
    "scans": {
      "tableName": "secretary_scans",
      "columns": [
        { "name": "repo", "type": "TEXT", "required": true },
        { "name": "filepath", "type": "TEXT", "required": true },
        { "name": "file_size", "type": "INTEGER", "required": true },
        { "name": "line_count", "type": "INTEGER", "required": true },
        { "name": "over_threshold", "type": "INTEGER", "required": true, "default": 0 }
      ],
      "indexes": ["repo", "over_threshold"]
    }
  }
}
