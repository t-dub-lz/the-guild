# Guild Environment Variables
# Copy this file to .env and fill in your values
# The .env file is automatically loaded by conclave.zsh

# Required for The Judge (AI instruction file analyzer)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: Override The Judge's default model (default: gpt-5-mini)
# THE_JUDGE_MODEL=gpt-4o

# Add other Guild member environment variables below as needed
